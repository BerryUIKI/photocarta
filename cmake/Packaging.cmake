set(CPACK_PACKAGE_NAME "PhotoCarta")
set(CPACK_PACKAGE_VENDOR "PhotoCarta Contributors")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Modern desktop photo management based on digiKam")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://github.com/BerryUIKI/photocarta")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_VERSION_MAJOR "${PROJECT_VERSION_MAJOR}")
set(CPACK_PACKAGE_VERSION_MINOR "${PROJECT_VERSION_MINOR}")
set(CPACK_PACKAGE_VERSION_PATCH "${PROJECT_VERSION_PATCH}")
set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_CONTACT "https://github.com/BerryUIKI/photocarta")

# Normalized architecture name
if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
    set(PHOTOCARTA_ARCH "x86_64")
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64|ARM64")
    set(PHOTOCARTA_ARCH "arm64")
else()
    set(PHOTOCARTA_ARCH "${CMAKE_SYSTEM_PROCESSOR}")
endif()

# Generator-specific settings
if(WIN32)
    set(CPACK_GENERATOR "ZIP")
    set(CPACK_PACKAGE_FILE_NAME "${CPACK_PACKAGE_NAME}-${CPACK_PACKAGE_VERSION}-windows-${PHOTOCARTA_ARCH}")
elseif(APPLE)
    set(CPACK_GENERATOR "DragNDrop;TGZ")
    set(CPACK_PACKAGE_FILE_NAME "${CPACK_PACKAGE_NAME}-${CPACK_PACKAGE_VERSION}-macos-${PHOTOCARTA_ARCH}")
else()
    set(CPACK_GENERATOR "TGZ;DEB")
    set(CPACK_PACKAGE_FILE_NAME "${CPACK_PACKAGE_NAME}-${CPACK_PACKAGE_VERSION}-linux-${PHOTOCARTA_ARCH}")
    set(CPACK_DEBIAN_PACKAGE_MAINTAINER "${CPACK_PACKAGE_VENDOR}")
    set(CPACK_DEBIAN_PACKAGE_SECTION "graphics")
    set(CPACK_DEBIAN_PACKAGE_HOMEPAGE "${CPACK_PACKAGE_HOMEPAGE_URL}")
    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
endif()

include(CPack)
